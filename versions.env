# Single source of truth for every pinned version/image in this repo.
#
# IMPORTANT: values below are researched starting points captured without direct access to the
# upstream Helm registries. CI (.github/workflows/lint.yaml, job "verify-versions") re-resolves
# each of these against the real registry/registry index on every push and fails the build if a
# pin does not exist or has been superseded. Treat a CI failure here as the versions needing an
# update, never as a reason to relax the check.
#
# When bumping a version: update it here, open a PR, let render-diff.yaml show the effect, and
# let e2e-kind.yaml / argocd-upgrade.yaml prove it still works. Never bump by editing a chart
# values file directly.

# --- kind ---
KIND_NODE_IMAGE="kindest/node:v1.32.8@sha256:abd489f042d2b644e2d033f5c2d900bc707798d075e8186cb65e3f1367a9d5a1"

# --- Argo CD (argo-helm chart) ---
# Upgrade rehearsal path: START -> STEP2 -> LATEST
ARGOCD_CHART_REPO="https://argoproj.github.io/argo-helm"
ARGOCD_CHART_NAME="argo-cd"
ARGOCD_CHART_VERSION_START="7.8.28"    # Argo CD v2.14.11 (pre-3.0 baseline)
ARGOCD_CHART_VERSION_STEP2="8.3.7"     # Argo CD v3.0.x   (crosses the documented 2.14->3.0 breaking boundary)
ARGOCD_CHART_VERSION_LATEST=""         # resolved at upgrade time: `helm search repo argo/argo-cd --versions | head -1`

# --- Apache Airflow (official chart) ---
AIRFLOW_CHART_REPO="https://airflow.apache.org"
AIRFLOW_CHART_NAME="airflow"
AIRFLOW_CHART_VERSION="1.22.0"
AIRFLOW_APP_VERSION="3.1.7"

# --- Airflow providers baked into the custom image ---
AIRFLOW_PROVIDER_HASHICORP_VERSION="latest"   # resolve via `pip index versions apache-airflow-providers-hashicorp`
AIRFLOW_PROVIDER_CNCF_KUBERNETES_VERSION="latest"
AIRFLOW_PROVIDER_AMAZON_VERSION="latest"   # S3Hook/S3TaskHandler; points at SeaweedFS, not real AWS

# --- External Secrets Operator ---
ESO_CHART_REPO="https://charts.external-secrets.io"
ESO_CHART_NAME="external-secrets"
ESO_CHART_VERSION="latest"   # resolve via `helm search repo external-secrets/external-secrets --versions`

# --- HashiCorp Vault (OSS) ---
VAULT_CHART_REPO="https://helm.releases.hashicorp.com"
VAULT_CHART_NAME="vault"
VAULT_CHART_VERSION="latest"
VAULT_IMAGE_TAG="latest"   # OSS build tag, e.g. hashicorp/vault:1.x.y

# --- Kubeflow Spark Operator ---
SPARK_OPERATOR_CHART_REPO="https://kubeflow.github.io/spark-operator"
SPARK_OPERATOR_CHART_NAME="spark-operator"
SPARK_OPERATOR_CHART_VERSION="2.5.2"   # resolved via `helm search repo spark-operator/spark-operator --versions`;
                                        # actual pin lives in platform/bootstrap/spark-operator-af-work-{a,b}.yaml
SPARK_IMAGE="apache/spark:4.0.4"   # matches the base Spark version spark-operator 2.5.2 itself
                                    # bumped to (see its v2.5.2 release notes) - the most reliable
                                    # signal for "latest compatible" absent a published matrix

# --- Headlamp (Kubernetes web UI, management cluster only) ---
HEADLAMP_CHART_REPO="https://kubernetes-sigs.github.io/headlamp"
HEADLAMP_CHART_NAME="headlamp"
HEADLAMP_CHART_VERSION="0.45.0"   # latest as of pinning; resolved via the chart repo's index.yaml
                                  # (helm search repo headlamp/headlamp --versions); chart appVersion
                                  # matches (0.45.0), so image.tag is left unset in the Application
                                  # and falls back to Chart.yaml's appVersion.

# --- SeaweedFS (S3-compatible object store, management cluster only) ---
# Apache-2.0 (chosen over MinIO specifically because MinIO's OSS edition is no longer fully
# open-source as of its 2025 licensing change). Gives Airflow remote task-log storage: worker pods
# are ephemeral under KubernetesExecutor and their logs are gone once the pod is (see
# docs/architecture.md) - S3-compatible remote_logging is Airflow's own documented fix for that.
SEAWEEDFS_CHART_REPO="https://seaweedfs.github.io/seaweedfs/helm"
SEAWEEDFS_CHART_NAME="seaweedfs"
SEAWEEDFS_CHART_VERSION="4.45.0"   # latest as of pinning; resolved via the chart repo's index.yaml
                                   # (helm search repo seaweedfs/seaweedfs --versions)

# --- Postgres (Airflow metadata DB, our own minimal chart) ---
POSTGRES_IMAGE="postgres:16-alpine"

# --- Local container registry (KIND) ---
LOCAL_REGISTRY_NAME="kind-registry"
LOCAL_REGISTRY_PORT="5001"

# --- Kueue (job queueing / quota admission, every workload cluster) ---
# Published ONLY as an OCI chart - there is no classic HTTP chart repo for Kueue (confirmed: the
# upstream repo has no gh-pages chart index). Argo CD >= 3.x consumes a public OCI chart with a
# plain `repoURL` + `chart` and NO `oci://` prefix and NO repository Secret (argo-cd v3.5.2
# docs/user-guide/helm.md: "note: the oci:// syntax is not included"); this cluster's Argo CD is
# on chart 10.8.0 / v3.5.x (platform/bootstrap/app-argocd-self.yaml), so that path applies.
KUEUE_CHART_REPO="registry.k8s.io/kueue/charts"
KUEUE_CHART_NAME="kueue"
KUEUE_CHART_VERSION="0.19.4"
KUEUE_APP_VERSION="v0.19.4"
# The chart's in-tree values.yaml points at a STAGING registry with a floating `release-0.19` tag,
# but hack/helm-chart-package.sh rewrites both to the promoted location for any `vX.Y.Z` release
# tag, so the published 0.19.4 chart already defaults to registry.k8s.io/kueue/kueue:v0.19.4.
# Pinned explicitly anyway: rule 1 (versions.env is the source of truth) and rule 7 (no floating
# tags in anything deployed) both want the tag stated here, not inherited from a chart default.
KUEUE_IMAGE_REPOSITORY="registry.k8s.io/kueue/kueue"

# --- Kyverno (admission policy: mutate + validate, every workload cluster) ---
# Chart version and appVersion diverge for this chart - chart 3.9.1 ships Kyverno v1.19.1
# (confirmed against charts/kyverno/Chart.yaml at the v1.19.1 tag).
KYVERNO_CHART_REPO="https://kyverno.github.io/kyverno/"
KYVERNO_CHART_NAME="kyverno"
KYVERNO_CHART_VERSION="3.9.1"
KYVERNO_APP_VERSION="v1.19.1"
# Kyverno's own images default to reg.kyverno.io (chart values: image.defaultRegistry), which is
# why that registry appears in the platform-component half of the allowlist in
# charts/cluster-governance/values.yaml.
KYVERNO_IMAGE_REGISTRY="reg.kyverno.io"
